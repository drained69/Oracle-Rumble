# Panta API credentials — see https://docs.panta.market/
#
# When PANTA_API_KEY is unset the server routes fall back to deterministic
# mock data so `npm run dev` works on a fresh clone.
#
# Never commit the real key. Use `.env.local` for development.
PANTA_API_KEY=
PANTA_API_BASE=https://live-api.panta.market/api/v1

# Partner attribution key sent with /trades/report so Oracle Rumble's
# leaderboard only counts qualifying on-chain trades routed through us.
PANTA_ATTRIBUTION_KEY=

# ── Solana cluster ──────────────────────────────────────────────────────
# Oracle Rumble runs on DEVNET with test-USDC. Flip to mainnet-beta only when
# legally cleared (prediction-market/wagering law, KYC) — swap the RPC + the
# Panta key + the USDC mint below and redeploy the escrow program.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ── Non-custodial escrow (real devnet USDC) ─────────────────────────────
# Set after deploying program/ (see program/README.md). When BOTH are set the
# app moves real USDC through the escrow program; otherwise it runs in ledger
# mode (server-side accounting only).
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
# Must match the USDC mint Panta uses on this cluster.
NEXT_PUBLIC_USDC_MINT=

# The round host's keypair signs settlement (SettlePlayer/CloseSettlement).
# Server-only — never exposed to the browser.
ESCROW_HOST_SECRET_KEY=

# Optional: gate POST /api/round?force to a trusted host.
ROUND_HOST_SECRET=
