# Panta API credentials — see https://docs.panta.market/
#
# When PANTA_API_KEY is unset the server routes fall back to deterministic
# mock data so `npm run dev` works on a fresh clone.
#
# Never commit the real key. Use `.env.local` for development.
PANTA_API_KEY=
PANTA_API_BASE=https://live-api.panta.market/api/v1

# Partner attribution identifier. Panta credits every order lifecycle
# call (X-User-Id header + userId body field) to this account. Get it
# from your /account/keys response's `userId` (looks like usr_…).
# PANTA_ATTRIBUTION_KEY was the legacy name for this variable — it is
# still read as a fallback but PANTA_USER_ID is preferred.
PANTA_USER_ID=

# ── Solana cluster ──────────────────────────────────────────────────────
# The deployed app runs on devnet with test USDC. For mainnet staging, change
# the cluster and mint together, use a dedicated HTTPS mainnet RPC (with a
# browser-safe key), and leave NEXT_PUBLIC_ESCROW_PROGRAM_ID empty until the reviewed
# program is deployed on mainnet. The public Solana RPC is only suitable for
# read-only staging; it is not a production transaction endpoint.
# Run `npm run preflight:mainnet` in the release environment before enabling
# real-funds features. See MAINNET_READINESS.md for the remaining gates.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ── Non-custodial escrow (real devnet USDC) ─────────────────────────────
# Set after deploying program/ (see program/README.md). When BOTH are set the
# app moves real USDC through the escrow program; otherwise it runs in ledger
# mode (server-side accounting only).
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
# Circle USDC: devnet 4zMMC...; mainnet EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v.
# Confirm the full mint address from Circle before setting it.
NEXT_PUBLIC_USDC_MINT=

# The round host's keypair signs settlement (SettlePlayer/CloseSettlement).
# Server-only — never exposed to the browser.
ESCROW_HOST_SECRET_KEY=

# Optional: gate POST /api/round?force to a trusted host.
ROUND_HOST_SECRET=

# ── Fees ─────────────────────────────────────────────────────────────────
# Wallet that receives the 0.1% platform fee on claims (its USDC account is
# created automatically). Defaults to the operator key above.
PLATFORM_FEE_WALLET=

# ── X usernames + embedded wallets (Privy) ──────────────────────────────
# Set to turn on "Connect X": usernames become X handles (set once, one X
# account per wallet), paid seats and hosting require it, and players
# without a wallet can sign in with X and play with a Privy embedded wallet.
# Leave empty to keep self-chosen usernames.
# In the Privy dashboard: enable Twitter (X) login, Solana embedded wallets
# and identity tokens; add this site's domain to the allowed origins.
# NEXT_PUBLIC_* is baked in at build time — redeploy after setting it.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: lets the server verify X accounts even with identity tokens off.
PRIVY_APP_SECRET=

# ── Oracle read (Claude) ────────────────────────────────────────────────
# Optional. When set, Claude phrases the Oracle read's headline from each
# live pit's market data (one shared call per pit every ~20s). Without it the
# read still works from the data alone.
ANTHROPIC_API_KEY=

# ── Storage & sessions ──────────────────────────────────────────────────
# Postgres for pits and rounds (in-memory when unset — fine for local dev).
DATABASE_URL=
# Independent random secret of at least 32 characters for session cookies.
# Changing it invalidates existing sessions. Never reuse an escrow key here.
SESSION_SECRET=
